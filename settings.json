// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
	"diff_view_style": "unified",
	"gutter": { "line_numbers": true },
	"agent": {
		"default_profile": "ask",
		"tool_permissions": {
			"tools": {
				"move_path": {
					"default": "allow",
				},
				"delete_path": {
					"default": "allow",
				},
				"create_directory": {
					"default": "allow",
				},
				"terminal": {
					"default": "allow",
				},
			},
		},
		"sidebar_side": "right",
		"dock": "right",
		"default_model": {
			"effort": "low",
			"enable_thinking": true,
			"provider": "openai-subscribed",
			"model": "gpt-5.5",
		},
		"commit_message_model": {
			"provider": "x_ai",
			"model": "grok-4-1-fast-non-reasoning",
		},
		"favorite_models": [],
		"model_parameters": [],
	},
	"close_on_file_delete": true,
	"agent_servers": {
		"codex-acp": {
			"type": "registry",
			"favorite_models": ["gpt-5.4/medium"],
		},
		"opencode": {
			"type": "extension",
			"favorite_models": ["opencode/grok-code"],
			"default_config_options": {},
			"favorite_config_option_values": {},
		},
	},
	"base_keymap": "VSCode",
	"buffer_font_family": "Menlo",
	"buffer_font_features": { "calt": false },
	"buffer_font_size": 12.0,
	"cursor_shape": "bar",
	"file_types": {
		"HTML": [
			"*.svg",
			"*.edge",
			"*.htm",
			"*.xhtml",
			"*.shtml",
			"*.ejs",
			"*.hbs",
			"*.mustache",
			"*.njk",
			"*.twig",
			"*.liquid",
			"*.jinja",
			"*.jinja2",
			"*.tmpl",
			"*.tpl",
		],
		"shellscript": ["**/bin/**/*"],
		"typescript": ["**/bin/**/*.ts"],
		"JSONC": ["**/.eslintrc", "**/tsconfig.json", "**/.prettierrc"],
	},
	"format_on_save": "off",
	"hard_tabs": true,
	"icon_theme": "Colored Zed Icons Theme Light",
	"languages": {
		"CSS": {
			"language_servers": [
				"tailwindcss-intellisense-css",
				"!vscode-css-language-server",
			],
		},
	},
	"semantic_tokens": "combined",
	"global_lsp_settings": {
		"semantic_token_rules": [
			{
				"token_type": "variable",
				"token_modifiers": ["readonly"],
				"style": ["constant"],
			},
			{ "token_type": "enumMember", "style": ["constant"] },
		],
	},
	"minimap": {
		"max_width_columns": 40,
	},
	"project_panel": {
		"dock": "left",
		"button": true,
		"folder_icons": false,
		"hide_root": true,
		"entry_spacing": "standard",
	},
	"git_panel": { "dock": "left" },
	"scrollbar": { "git_diff": false },
	"show_edit_predictions": false,
	"soft_wrap": "editor_width",
	"sticky_scroll": {
		"enabled": false,
	},
	"tab_bar": {
		"show_tab_bar_buttons": false,
		"show_nav_history_buttons": false,
	},
	"tab_size": 2,
	"tabs": { "show_diagnostics": "all", "file_icons": true, "git_status": true },
	"telemetry": { "metrics": false, "diagnostics": false },
	"terminal": { "dock": "bottom" },
	"theme": "VS Code Dark+",
	"toolbar": { "quick_actions": false, "breadcrumbs": false },
	"ui_font_size": 15.0,
	"ui_font_weight": 500.0,
	"lsp": {
		"eslint": {
			"settings": {
				"onIgnoredFiles": "off",
			},
		},
	},
}
